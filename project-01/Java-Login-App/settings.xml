<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="
            http://maven.apache.org/SETTINGS/1.2.0
            https://maven.apache.org/xsd/settings-1.2.0.xsd">

    <!-- Mirror the project's repository IDs to the lab Artifactory URLs.
         Mirror IDs are also used to select the matching credentials below. -->
    <mirrors>
        <mirror>
            <id>artifactory</id>
            <mirrorOf>*</mirrorOf>
            <url>http://172.20.0.14:8081/artifactory/maven-virtual</url>
        </mirror>

        <mirror>
            <id>central</id>
            <mirrorOf>*</mirrorOf>
            <url>http://172.20.0.14:8081/artifactory/libs-release-local</url>
        </mirror>

        <mirror>
            <id>snapshots</id>
            <mirrorOf>*</mirrorOf>
            <url>http://172.20.0.14:8081/artifactory/libs-snapshot-local</url>
        </mirror>
    </mirrors>

    <servers>
        <server>
            <id>TomcatServer</id>
            <username>${env.TOM_USER}</username>
            <password>${env.TOM_TOKEN}</password>
        </server>

        <server>
            <id>central</id>
            <username>${env.JFROG_USER}</username>
            <password>${env.JFROG_TOKEN}</password>
        </server>

        <server>
            <id>snapshots</id>
            <username>${env.JFROG_USER}</username>
            <password>${env.JFROG_TOKEN}</password>
        </server>
        <server>
            <id>artifactory</id>
            <username>${env.JFROG_USER}</username>
            <password>${env.JFROG_TOKEN}</password>
        </server>
    </servers>

    <profiles>
        <profile>
            <id>artifactory-lab</id>

            <repositories>
                <repository>
                    <id>central</id>
                    <name>eb349ec03dbd-releases</name>
                    <url>http://172.20.0.14:8081/artifactory/libs-release-local</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </repository>

                <repository>
                    <id>snapshots</id>
                    <name>eb349ec03dbd-snapshots</name>
                    <url>http://172.20.0.14:8081/artifactory/libs-snapshot-local</url>
                    <releases>
                        <enabled>false</enabled>
                    </releases>
                    <snapshots>
                        <enabled>true</enabled>
                    </snapshots>
                </repository>
            </repositories>

            <pluginRepositories>
                <pluginRepository>
                    <id>central</id>
                    <name>eb349ec03dbd-releases</name>
                    <url>http://172.20.0.14:8081/artifactory/libs-release-local</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </pluginRepository>

                <pluginRepository>
                    <id>snapshots</id>
                    <name>eb349ec03dbd-snapshots</name>
                    <url>http://172.20.0.14:8081/artifactory/libs-snapshot-local</url>
                    <releases>
                        <enabled>false</enabled>
                    </releases>
                    <snapshots>
                        <enabled>true</enabled>
                    </snapshots>
                </pluginRepository>
            </pluginRepositories>
        </profile>
    </profiles>

    <activeProfiles>
        <activeProfile>artifactory-lab</activeProfile>
    </activeProfiles>

</settings>